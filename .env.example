APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=routerverse
DB_USERNAME=routerverse
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email dipakai untuk verifikasi pendaftaran dan kode OTP login.
# "log" = email hanya ditulis ke storage/logs/laravel.log (untuk uji lokal). Di server isi SMTP sungguhan:
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@routerverse.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# Keamanan masuk akun (lihat docs/AUTENTIKASI.md)
AUTH_EMAIL_VERIFICATION=true
AUTH_OTP_ENABLED=true
AUTH_OTP_ADMIN_REQUIRED=true
AUTH_OTP_TTL=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60

# Cloudflare Turnstile di halaman login dan daftar (lihat docs/AUTENTIKASI.md).
# Kosongkan kedua kunci untuk mematikannya. Untuk uji lokal bisa pakai kunci uji dari dokumentasi Turnstile.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Provisioning: MikroTik CHR ---
MIKROTIK_HOST=192.168.1.10
MIKROTIK_REST_PORT=443
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_USE_SSL=true
MIKROTIK_PPP_PROFILE=vpn-profile
MIKROTIK_VPN_IP_BASE=10.20.0.
MIKROTIK_VPN_IP_START=10

# --- Provisioning: Docker host ---
# Docker host (192.168.5.45) diakses lewat API Portainer. Ganti 2 ke ID environment Portainer-mu.
DOCKER_API_URL=http://192.168.5.45:4500/api/endpoints/2/docker
DOCKER_API_KEY=
DOCKER_API_VERIFY=false
MIKHMON_IMAGE=animegasan/mikhmon:v3-latest
DOCKER_NETWORK=mikhmon-net
MIKHMON_BASE_DOMAIN=mikhmonverse.my.id
MIKHMON_MEMORY_MB=128
# true = beri kotak login (basic auth) di depan Mikhmon. Default false: langsung ke login Mikhmon.
MIKHMON_GATE=false

# --- VPN Remote: RouterOS API server VPN (L2TP). Ulangi untuk IDN2 bila ada. ---
VPN_HOST_IDN1=routerverse.web.id
VPN_PUBLIC_IP_IDN1=
VPN_SUBNET_IDN1=11.11.11.
VPN_API_HOST_IDN1=
VPN_API_PORT_IDN1=8728
VPN_API_USER_IDN1=
VPN_API_PASSWORD_IDN1=
VPN_API_SSL_IDN1=false
VPN_WATCHDOG_SECONDS=60

# --- Duitku POP (top up poin). Dapatkan dari dashboard Duitku, proyek sandbox dulu. ---
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_MIN_TOPUP=10000
# Biaya ditanggung pembeli = flat + persen dari nominal. Isi sesuai biaya Duitku (0 = Anda yang menanggung).
DUITKU_FEE_FLAT=0
DUITKU_FEE_PERCENT=0

# Alamat usaha lengkap (tampil di beranda, diminta Duitku)
BUSINESS_ADDRESS="Jalan Bojong Citepus, Cangkuang Wetan RT6 / RW9 Dayeuhkolot, Kab. Bandung, Jawa Barat 40257"
BUSINESS_EMAIL=iqbalrinaldi098@gmail.com
